# การตั้งค่าระบบร้าน 160 ธีระ สายซิ่ง (160 Teera Sai Sing)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามการใช้งานจริง

# รหัสความปลอดภัยของเซสชัน Flask (Secret Key)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key

# การตั้งค่าเซิร์ฟเวอร์ส่งอีเมล (SMTP Configuration) สำหรับระบบลืมรหัสผ่าน
# สำหรับ Gmail ให้สร้าง App Password จาก Google Account Security
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
MAIL_FROM=noreply@160teerasaising.com
